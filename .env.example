# 前端配置
PORT=5000
FRONTEND_PORT=3000

# 后端配置
BACKEND_PORT=3001
NODE_ENV=development

# JWT 密钥配置（必须设置，用于签名和验证 JWT token）
JWT_SECRET=your_jwt_secret_key_here

# 数据库配置
DATABASE_URL=file:./prisma/dev.db

# ============================================
# AI 导师 LLM 提供商配置（可选功能）
# ============================================
# 如果不配置以下 AI 相关环境变量，AI 导师功能将不可用
# 但不影响项目的其他核心功能（练习、试卷管理等）正常使用
# 选择使用的 LLM 提供商: vllm | openai | anthropic | aliyun
AI_PROVIDER=openai

# OpenAI 配置
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=your_openai_api_key_here
AI_OPENAI_MODEL=gpt-4o-mini

# vLLM 配置 (自部署)
AI_VLLM_BASE_URL=your_vllm_base_url_here
AI_VLLM_API_KEY=your_vllm_api_key_here
AI_VLLM_MODEL=your_vllm_model_name

# Anthropic 配置
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 阿里云 DashScope 配置
AI_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ALIYUN_API_KEY=your_aliyun_api_key_here
AI_ALIYUN_MODEL=qwen3.6-plus

# AI 对话历史配置
AI_CHAT_RETENTION_DAYS=14
AI_CHAT_MAX_ROUNDS=20
